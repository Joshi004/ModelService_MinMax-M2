# ============================================================================
# MiniMax M2 Service Configuration
# Environment variables for the vLLM service
# ============================================================================

# ----------------------------------------------------------------------------
# SYSTEM COMPATIBILITY
# ----------------------------------------------------------------------------

# SAFETENSORS_FAST_GPU: Enables fast GPU loading for SafeTensors format
#   Value: 1 (enabled) or 0 (disabled)
#   Impact: Speeds up model initialization by 30-50%
#   Recommended: Keep enabled for faster startup with large models
export SAFETENSORS_FAST_GPU=1

# ----------------------------------------------------------------------------
# CUDA ENVIRONMENT
# ----------------------------------------------------------------------------

# CUDA_HOME: Path to CUDA installation directory
#   Purpose: Tells the system where CUDA libraries are installed
#   Change: Update if your CUDA is installed in a different location
export CUDA_HOME=/usr/local/cuda-12.9
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

# ----------------------------------------------------------------------------
# MODEL CONFIGURATION
# ----------------------------------------------------------------------------

# MODEL_PATH: Path to the model weights and configuration files
#   Purpose: Location of the MiniMax-M2 model on disk
#   Note: Model will be auto-downloaded on first run if not present
#   Change: Update if you move the model to a different directory
MODEL_PATH="/home/naresh/models/minimax-m2"

# MODEL_NAME: HuggingFace model identifier
#   Used for downloading the model if not present locally
MODEL_NAME="MiniMaxAI/MiniMax-M2"

# PORT: Network port where the API server listens
#   Default: 8084
#   Impact: Client requests must use this port (http://localhost:7104)
#   Change: Use a different port if 8084 is already in use
PORT=7104

# HOST: Network interface to bind the server
#   "0.0.0.0": Listen on all network interfaces (accessible from any IP)
#   "127.0.0.1": Listen only on localhost (more secure, local access only)
#   Impact: Controls whether remote machines can access the service
HOST="0.0.0.0"

# DTYPE: Data type precision for model weights
#   Options: "float16", "bfloat16", "float32"
#   "bfloat16": Balanced precision and speed (RECOMMENDED for H100)
#   "float16": Faster but less stable, may cause NaN issues
#   "float32": Highest precision, but uses 2x memory and slower
#   Impact: Lower precision = faster inference but slightly reduced quality
DTYPE="bfloat16"

# ----------------------------------------------------------------------------
# PERFORMANCE & CAPACITY SETTINGS
# ----------------------------------------------------------------------------

# MAX_MODEL_LEN: Maximum context length (input + output tokens)
#   Purpose: Controls how much input the model can process at once
#   Current: 128000 tokens (full 128K context support)
#   Maximum: 128000 tokens (model's native context window)
#   
#   Impact of changing:
#     ✓ Higher value = Can process longer inputs
#     ✗ Uses MORE GPU memory per request
#     ✗ SLOWER inference (more computation)
#     ✗ Reduces MAX_NUM_SEQS capacity
#   
#   Recommended values:
#     32768  = Short contexts, 32+ concurrent requests
#     65536  = Medium contexts, 16-24 concurrent requests
#     128000 = Full context, 16 concurrent requests (CURRENT)
MAX_MODEL_LEN=128000

# TENSOR_PARALLEL_SIZE: Number of GPUs to split the model across
#   Purpose: Distributes model weights across multiple GPUs
#   Current: 4 (using all 4x H100 GPUs)
#   
#   Impact:
#     ✓ Higher value = Can run larger models
#     ✓ Provides more total memory (4x80GB = 320GB)
#     ✗ Slight communication overhead between GPUs
#   
#   Rule: Must match the number of available GPUs
#   Note: MiniMax M2 requires ~220GB, so 4x H100 is recommended
TENSOR_PARALLEL_SIZE=4

# GPU_MEMORY_UTIL: Fraction of GPU memory to use for model
#   Range: 0.0 to 1.0 (0.95 = 95% of available memory)
#   Current: 0.95 (uses ~76GB per H100 out of 80GB)
#   
#   Impact of increasing (e.g., 0.98):
#     ✓ Can handle slightly more concurrent requests
#     ✗ Higher risk of Out-of-Memory (OOM) errors
#     ✗ Less room for memory spikes
#   
#   Impact of decreasing (e.g., 0.85):
#     ✓ More stable, less likely to crash
#     ✓ Leaves room for other processes
#     ✗ Fewer concurrent requests possible
#   
#   Recommended: 0.90-0.95 for production
GPU_MEMORY_UTIL=0.95

# MAX_NUM_SEQS: Maximum number of concurrent sequences (batch size)
#   Purpose: How many requests can be processed simultaneously
#   Current: 16 concurrent requests
#   
#   Impact of increasing (e.g., 32):
#     ✓ Higher throughput (more requests handled)
#     ✗ Requires MORE GPU memory
#     ✗ May cause OOM if MAX_MODEL_LEN is large
#   
#   Impact of decreasing (e.g., 8):
#     ✓ Uses LESS memory, more stable
#     ✓ Better for very long contexts
#     ✗ Lower throughput
#   
#   Note: MiniMax M2's MoE architecture allows higher concurrency
#   than dense models due to sparse activation (only 10B active)
MAX_NUM_SEQS=16

# ----------------------------------------------------------------------------
# GENERATION PARAMETERS (Server Defaults - Caller can override)
# ----------------------------------------------------------------------------

# TEMPERATURE: Controls randomness in token selection
#   Range: 0.0 to 2.0
#   Current: 1.0 (MiniMax M2 recommended default)
#   
#   Lower (0.1-0.3):
#     ✓ More deterministic, focused, consistent
#     ✓ Better for factual tasks (code generation, analysis)
#     ✗ Less creative, may repeat phrases
#   
#   Medium (0.5-0.8):
#     ✓ Balanced creativity and coherence
#     ✓ Good for general tasks
#   
#   Higher (0.9-1.5):
#     ✓ More creative, diverse outputs (RECOMMENDED for MiniMax M2)
#     ✓ Better for brainstorming, exploration
#     ✗ Less predictable
#   
#   Note: MiniMax M2 is optimized for temperature=1.0
#   Caller can override this value in their request
TEMPERATURE=1.0

# TOP_P: Nucleus sampling - cumulative probability threshold
#   Range: 0.0 to 1.0
#   Current: 0.95 (consider top 95% probability mass)
#   
#   How it works:
#     Model considers tokens until cumulative probability reaches TOP_P
#     Filters out unlikely tokens dynamically
#   
#   Lower (0.5-0.7):
#     ✓ More conservative, safer word choices
#     ✓ Reduces hallucination
#     ✗ Less diverse vocabulary
#   
#   Medium (0.8-0.95):
#     ✓ Good balance (RECOMMENDED)
#     ✓ Natural language flow
#   
#   Higher (0.95-1.0):
#     ✓ Maximum diversity (CURRENT)
#     ✗ May include unlikely words
#   
#   Note: Works together with TEMPERATURE
#   Caller can override this value in their request
TOP_P=0.95

# TOP_K: Limits vocabulary to K most likely tokens
#   Range: 1 to vocab_size (typically 10-100)
#   Current: 20 (consider only top 20 most likely tokens)
#   
#   How it works:
#     At each step, only consider the K most probable next tokens
#     Filters out very unlikely tokens
#   
#   Lower (5-15):
#     ✓ More focused, deterministic
#     ✓ Reduces nonsensical outputs
#     ✗ Limited vocabulary, less natural
#   
#   Medium (20-40):
#     ✓ Good balance (RECOMMENDED)
#     ✓ Natural while preventing wild choices
#   
#   Higher (50-100):
#     ✓ More diverse vocabulary
#     ✗ May generate less coherent text
#   
#   Note: Works together with TOP_P - whichever is more restrictive applies
#   Caller can override this value in their request
TOP_K=20

# MAX_TOKENS: Maximum number of tokens to generate in response
#   Range: 1 to MAX_MODEL_LEN
#   Current: 16384 (~12,000 words)
#   
#   How it works:
#     Sets upper limit on response length
#     Model stops generating when it reaches this limit OR completes naturally
#   
#   Impact:
#     ✓ Prevents overly long responses
#     ✓ Controls API costs/latency
#     ✗ May truncate detailed analyses if too low
#   
#   Considerations:
#     Total tokens used = Input tokens + MAX_TOKENS
#     Must fit within MAX_MODEL_LEN
#   
#   Recommended values:
#     4096  = Short answers (~3,000 words)
#     8192  = Medium responses (~6,000 words)
#     16384 = Long detailed analyses (~12,000 words) (CURRENT)
#     32768 = Very comprehensive reports
#   
#   Caller can override this value in their request
MAX_TOKENS=16384

# ----------------------------------------------------------------------------
# MINIMAX M2 SPECIFIC SETTINGS
# ----------------------------------------------------------------------------

# ENABLE_AUTO_TOOL_CHOICE: Automatically select appropriate tools
#   Value: true/false
#   Impact: Model automatically decides when to use tools based on context
#   Recommended: true for MiniMax M2's agentic capabilities
ENABLE_AUTO_TOOL_CHOICE=true

# TOOL_CALL_PARSER: Parser for tool call format
#   Value: minimax_m2
#   Impact: Correctly parses MiniMax M2's tool calling JSON format
#   DO NOT CHANGE: Required for tool calling to work
TOOL_CALL_PARSER="minimax_m2"

# REASONING_PARSER: Parser for reasoning/thinking content
#   Value: minimax_m2 (strips think tags) or minimax_m2_append_think (preserves tags)
#   Impact: Controls whether <think>...</think> tags appear in responses
#   Note: Using minimax_m2 will strip think tags from the response
#         while still allowing the model to use internal reasoning.
REASONING_PARSER="minimax_m2"

# ----------------------------------------------------------------------------
# PARAMETER TUNING GUIDE
# ----------------------------------------------------------------------------
#
# For CODING tasks (MiniMax M2's specialty):
#   TEMPERATURE=1.0, TOP_P=0.95, TOP_K=20  (CURRENT DEFAULT)
#
# For FACTUAL/PRECISE tasks (when you need determinism):
#   TEMPERATURE=0.2, TOP_P=0.9, TOP_K=10
#
# For CREATIVE exploration (brainstorming, ideation):
#   TEMPERATURE=1.2, TOP_P=0.95, TOP_K=40
#
# For VERY SAFE/CONSERVATIVE output:
#   TEMPERATURE=0.1, TOP_P=0.85, TOP_K=10
#
# Remember: These are server defaults. Callers can override them
# in their API requests for specific use cases.
#
# ============================================================================

