# ============================================================================
# MiniMax M2 Service Configuration - EXAMPLE FILE
# Copy this file to config.env and update the paths for your system
# ============================================================================

# ----------------------------------------------------------------------------
# SYSTEM COMPATIBILITY
# ----------------------------------------------------------------------------

export SAFETENSORS_FAST_GPU=1

# ----------------------------------------------------------------------------
# CUDA ENVIRONMENT
# ----------------------------------------------------------------------------

# Update these paths to match your CUDA installation
export CUDA_HOME=/usr/local/cuda-12.9
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

# ----------------------------------------------------------------------------
# MODEL CONFIGURATION
# ----------------------------------------------------------------------------

# Update MODEL_PATH to your desired model storage location
MODEL_PATH="/path/to/your/models/minimax-m2"

# HuggingFace model identifier (do not change unless using a different model)
MODEL_NAME="MiniMaxAI/MiniMax-M2"

# Network configuration
PORT=8084
HOST="0.0.0.0"
DTYPE="bfloat16"

# ----------------------------------------------------------------------------
# PERFORMANCE & CAPACITY SETTINGS
# ----------------------------------------------------------------------------

# Context and memory settings
MAX_MODEL_LEN=128000         # Full 128K context support
TENSOR_PARALLEL_SIZE=4       # Number of GPUs (adjust based on your hardware)
GPU_MEMORY_UTIL=0.95         # 95% GPU memory utilization
MAX_NUM_SEQS=16             # Concurrent requests

# ----------------------------------------------------------------------------
# GENERATION PARAMETERS (Server Defaults)
# ----------------------------------------------------------------------------

# These are defaults - callers can override in API requests
TEMPERATURE=1.0              # MiniMax M2 recommended default
TOP_P=0.95                   # Nucleus sampling threshold
TOP_K=20                     # Top-k sampling
MAX_TOKENS=16384            # Maximum response length

# ----------------------------------------------------------------------------
# MINIMAX M2 SPECIFIC SETTINGS
# ----------------------------------------------------------------------------

ENABLE_AUTO_TOOL_CHOICE=true
TOOL_CALL_PARSER="minimax_m2"
REASONING_PARSER="minimax_m2_append_think"

# ============================================================================

